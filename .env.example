# Copy to .env and fill in real values. Never commit .env.

# Keepa API key, used for Amazon price, rank and sales lookups
KEEPA_API_KEY=your-keepa-api-key
# Default Discord webhook for alerts (fallback for every monitor)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token

# ArbiSource extension API key, exchanged for a JWT at start-up
ARBISOURCE_API_KEY=your-arbisource-extension-key
# ArbiSource marketplace region sent with every request
ARBISOURCE_REGION=UK
# Discord webhook for the ArbiSource price-drop monitor (optional, falls back to DISCORD_WEBHOOK_URL)
ARBISOURCE_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token

# Discord webhook for the Currys monitor
CURRYS_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token
# Discord webhook for the HotUKDeals HOT-deal monitor
HUKD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token
# Discord webhook for the Argos monitor
ARGOS_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token
# Discord webhook for the TK Maxx monitor (optional, falls back to the Argos webhook)
TKMAXX_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token

# Optional HTTP proxy for the Playwright scraper (leave unset to connect directly)
PROXY_SERVER=http://proxy.example.com:8000
# Proxy username (only if PROXY_SERVER is set)
PROXY_USERNAME=proxy-user
# Proxy password (only if PROXY_SERVER is set)
PROXY_PASSWORD=proxy-password
